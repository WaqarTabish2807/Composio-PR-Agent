# Composio & Anthropic Configuration
COMPOSIO_API_KEY=your_composio_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# User Identification (for workspace connections)
USER_EMAIL=your_email@domain.com

# Composio Integration Auth Configurations
# These can be created in the Composio Dashboard -> Integrations -> GitHub / Linear
GITHUB_AUTH_CONFIG_ID=ac_github_config_id_here
LINEAR_AUTH_CONFIG_ID=ac_linear_config_id_here

# Composio Webhook Verification (Optional, but recommended)
COMPOSIO_WEBHOOK_SECRET=your_composio_webhook_secret_here
